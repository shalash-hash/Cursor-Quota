<UserControl x:Class="Quota.Controls.DailyTargetProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Quota.Controls">
    <StackPanel>
        <controls:GraduatedProgressBar Value="{Binding DailyPrimaryFillPercent, Mode=OneWay}"
                                       SecondaryValue="{Binding DailySecondaryFillPercent, Mode=OneWay}"
                                       FillBrush="{StaticResource DailyProgressBrush}"
                                       SecondaryBrush="{StaticResource AheadOfScheduleBrush}"/>

        <Grid Margin="0,5,0,0">
            <TextBlock Text="{Binding DailyProgressNormLabel}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource DailyProgressBrush}"/>
            <TextBlock Text="{Binding DailyProgressAheadLabel}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AheadOfScheduleBrush}"
                       HorizontalAlignment="Right">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DailyProgressAheadLabel}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </StackPanel>
</UserControl>
