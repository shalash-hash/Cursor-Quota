<UserControl x:Class="Quota.Controls.GraduatedProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="16"
             ClipToBounds="False">
    <Grid x:Name="Track"
          ClipToBounds="True">
        <Border CornerRadius="8"
                BorderBrush="{DynamicResource ProgressTubeBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource ProgressTrackBrush}"/>

        <Border Margin="1"
                CornerRadius="7"
                ClipToBounds="True">
            <Grid>
                <Border x:Name="PrimaryFill"
                        HorizontalAlignment="Left"
                        CornerRadius="6,0,0,6"/>
                <Border x:Name="SecondaryFill"
                        HorizontalAlignment="Left"
                        CornerRadius="0,6,6,0"
                        Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Grid Margin="1"
              IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="1"
                       Width="1"
                       HorizontalAlignment="Left"
                       Margin="0,3"
                       Fill="{DynamicResource ProgressTickBrush}"/>
            <Rectangle Grid.Column="2"
                       Width="1"
                       HorizontalAlignment="Left"
                       Margin="0,3"
                       Fill="{DynamicResource ProgressTickBrush}"/>
            <Rectangle Grid.Column="3"
                       Width="1"
                       HorizontalAlignment="Left"
                       Margin="0,3"
                       Fill="{DynamicResource ProgressTickBrush}"/>
        </Grid>

        <Border Margin="2,2,2,9"
                CornerRadius="5,5,0,0"
                VerticalAlignment="Top"
                Height="5"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#66FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
