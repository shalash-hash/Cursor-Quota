<Window x:Class="Quota.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:Quota.Localization"
        xmlns:controls="clr-namespace:Quota.Controls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{loc:Loc AppTitle}"
        Icon="Assets/app_icon.ico"
        Width="840"
        Height="547"
        MinWidth="760"
        MinHeight="480"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        FlowDirection="{Binding CurrentFlowDirection, Source={x:Static loc:LocalizationService.Instance}}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc AppTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc LanguageLabel}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding SupportedLanguages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="NativeName"
                              Style="{StaticResource AppComboBox}"
                              Width="170"
                              Height="28"
                              Margin="0,0,10,0"
                              VerticalContentAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <TextBlock Text="{loc:Loc DarkModeLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ToggleButton IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                                      Style="{StaticResource ThemeToggleSwitch}"
                                      VerticalAlignment="Center"/>
                    </StackPanel>
                    <ToggleButton IsChecked="{Binding IsStatisticsView, Mode=TwoWay}"
                                  ToolTip="{Binding ViewToggleTooltip}"
                                  Margin="0,0,0,0"
                                  VerticalAlignment="Center">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButton}">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <Viewbox Width="16" Height="16">
                                            <Canvas Width="20" Height="20">
                                                <Path Stroke="{DynamicResource PrimaryTextBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M2,15 L6,10 L10,12 L14,6 L18,9"/>
                                                <Path Stroke="{DynamicResource PrimaryTextBrush}"
                                                      StrokeThickness="1.8"
                                                      Data="M2,17 L18,17"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="20" Height="20">
                                                        <Rectangle Width="7" Height="7" Canvas.Left="2" Canvas.Top="2"
                                                                   Fill="{DynamicResource PrimaryTextBrush}"/>
                                                        <Rectangle Width="7" Height="7" Canvas.Left="11" Canvas.Top="2"
                                                                   Fill="{DynamicResource PrimaryTextBrush}"/>
                                                        <Rectangle Width="7" Height="7" Canvas.Left="2" Canvas.Top="11"
                                                                   Fill="{DynamicResource PrimaryTextBrush}"/>
                                                        <Rectangle Width="7" Height="7" Canvas.Left="11" Canvas.Top="11"
                                                                   Fill="{DynamicResource PrimaryTextBrush}"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid Visibility="{Binding IsStatisticsView, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource CardBorder}"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="136"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding TotalUsedPercentText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="40"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{loc:Loc TotalUsedLabel}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,2,0,2"/>
                            <TextBlock Text="{Binding TotalPoolsDetailText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalSpendText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding EstimatedLimitHintText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <controls:GraduatedProgressBar Grid.Row="1"
                                                       Value="{Binding TotalProgressValue, Mode=OneWay}"
                                                       FillBrush="{DynamicResource AccentBrush}"/>
                        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,10,0,0">
                            <TextBlock Text="{Binding TotalProgressLabel}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding TotalRemainingText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="13"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding DaysUntilResetText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="13"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding TotalTodaySpentText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SpentTodayBrush}"/>
                            <TextBlock Text="{Binding TotalYesterdaySpentText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SpentYesterdayBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Background="{DynamicResource AccentLightBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="136"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Top">
                            <TextBlock Text="{loc:Loc DailyTargetLabel}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding TotalDailyTargetText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <controls:GraduatedProgressBar Grid.Row="1"
                                                       Value="{Binding DailyPrimaryFillPercent, Mode=OneWay}"
                                                       SecondaryValue="{Binding DailySecondaryFillPercent, Mode=OneWay}"
                                                       FillBrush="{StaticResource DailyProgressBrush}"
                                                       SecondaryBrush="{StaticResource AheadOfScheduleBrush}"/>
                        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding DailyProgressNormLabel}"
                                           Style="{StaticResource CardCenteredText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DailyProgressBrush}"/>
                                <TextBlock Text="{Binding DailyProgressAheadLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CardCenteredText}">
                                            <Setter Property="Foreground" Value="{StaticResource AheadOfScheduleBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DailyProgressAheadLabel}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding DailyTodaySpentText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SpentTodayBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding DailyTodayBreakdownText}"
                                       Margin="0,0,0,2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardCenteredText}">
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DailyTodayBreakdownText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding DailyYesterdaySpentText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SpentYesterdayBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TodayStatusText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource CardBorder}"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="100"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Top">
                            <TextBlock Text="{loc:Loc CursorModelsLabel}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding FirstPartyUsedPercentText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource FirstPartyBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{loc:Loc UsedLabel}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding FirstPartySpendText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardCenteredText}">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FirstPartySpendText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding FirstPartyRemainingText}"
                                       FontSize="11"
                                       Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardCenteredText}">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FirstPartyRemainingText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <controls:GraduatedProgressBar Grid.Row="1"
                                                       Value="{Binding FirstPartyProgressValue, Mode=OneWay}"
                                                       FillBrush="{DynamicResource FirstPartyBrush}"/>
                        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,6,0,0">
                            <TextBlock Text="{Binding FirstPartyPaceText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding FirstPartyTodaySpentText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SpentTodayBrush}"/>
                            <TextBlock Text="{Binding FirstPartyYesterdaySpentText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SpentYesterdayBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource CardBorder}"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="100"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Top">
                            <TextBlock Text="{loc:Loc ApiLabel}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ApiUsedPercentText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ApiBrush}"/>
                        </StackPanel>
                        <controls:GraduatedProgressBar Grid.Row="1"
                                                       Value="{Binding ApiProgressValue, Mode=OneWay}"
                                                       FillBrush="{DynamicResource ApiBrush}"/>
                        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,6,0,0">
                            <TextBlock Text="{Binding ApiSpendText}"
                                       FontSize="11"
                                       Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardCenteredText}">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ApiSpendText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ApiPaceText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ApiTodaySpentText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SpentTodayBrush}"/>
                            <TextBlock Text="{Binding ApiYesterdaySpentText}"
                                       Style="{StaticResource CardCenteredText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SpentYesterdayBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,10,0,0">
                    <TextBlock Text="{Binding LastUpdateText}"
                               Style="{StaticResource CardCenteredText}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding PaceStatusText}"
                               Style="{StaticResource CardCenteredText}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding TodayPoolsDetailText}"
                               Style="{StaticResource CardCenteredText}"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                </Grid>
                </Grid>

                <Grid Visibility="{Binding IsStatisticsView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc StatisticsTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding HistoryRangeOptions}"
                                  SelectedValue="{Binding SelectedHistoryRange}"
                                  SelectedValuePath="Range"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource AppComboBox}"
                                  MinWidth="130"
                                  Height="28"/>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding StatisticsSummaryText}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,10"/>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource CardBorder}"
                                Padding="12"
                                VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{loc:Loc DailyUsageChartTitle}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,16,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Rectangle Width="10" Height="10" Fill="{DynamicResource FirstPartyBrush}" RadiusX="2" RadiusY="2" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Loc StatisticsLegendModels}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="10" Height="10" Fill="{DynamicResource ApiBrush}" RadiusX="2" RadiusY="2" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Loc StatisticsLegendApi}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <controls:UsageHistoryChart Grid.Row="1"
                                                            Points="{Binding UsageHistoryPoints}"
                                                            DecimalPlaces="{Binding SelectedDecimalPlaces}"
                                                            Section="{x:Static controls:UsageHistoryChartSection.Daily}"
                                                            VerticalAlignment="Stretch"
                                                            HorizontalAlignment="Stretch"
                                                            MinHeight="100">
                                    <controls:UsageHistoryChart.Style>
                                        <Style TargetType="controls:UsageHistoryChart">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStatisticsData}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:UsageHistoryChart.Style>
                                </controls:UsageHistoryChart>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Style="{StaticResource CardBorder}"
                                Padding="12"
                                Margin="0,10,0,0"
                                VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Rectangle Width="10" Height="10" Fill="{DynamicResource AccentBrush}" RadiusX="2" RadiusY="2" Margin="0,0,6,0"/>
                                    <TextBlock Text="{loc:Loc CumulativeUsageChartTitle}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                                <controls:UsageHistoryChart Grid.Row="1"
                                                            Points="{Binding UsageHistoryPoints}"
                                                            DecimalPlaces="{Binding SelectedDecimalPlaces}"
                                                            Section="{x:Static controls:UsageHistoryChartSection.Cumulative}"
                                                            VerticalAlignment="Stretch"
                                                            HorizontalAlignment="Stretch"
                                                            MinHeight="100">
                                    <controls:UsageHistoryChart.Style>
                                        <Style TargetType="controls:UsageHistoryChart">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStatisticsData}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:UsageHistoryChart.Style>
                                </controls:UsageHistoryChart>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Text="{loc:Loc StatisticsEmptyData}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStatisticsData}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource ErrorBackgroundBrush}"
                    BorderBrush="{DynamicResource ErrorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,10,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource ErrorBrush}"
                           TextWrapping="Wrap"
                           FontSize="12"/>
            </Border>

            <CheckBox Grid.Row="3"
                      Content="{loc:Loc LaunchWithWindows}"
                      IsChecked="{Binding IsStartupEnabled}"
                      Style="{StaticResource AppCheckBox}"
                      FontSize="12"
                      Margin="0,12,0,0"
                      Foreground="{DynamicResource PrimaryTextBrush}"/>
    </Grid>
</Window>


