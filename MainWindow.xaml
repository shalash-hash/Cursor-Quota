<Window x:Class="Quota.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:Quota.Localization"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{loc:Loc AppTitle}"
        Icon="Assets/app_icon.ico"
        Width="840"
        Height="460"
        MinWidth="760"
        MinHeight="420"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        FlowDirection="{Binding CurrentFlowDirection, Source={x:Static loc:LocalizationService.Instance}}"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc AppTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc LanguageLabel}"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding SupportedLanguages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="NativeName"
                              Width="170"
                              Height="28"
                              Margin="0,0,10,0"
                              VerticalContentAlignment="Center"/>
                    <TextBlock Text="{loc:Loc PrecisionLabel}"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding PrecisionOptions}"
                              SelectedItem="{Binding SelectedDecimalPlaces}"
                              Width="58"
                              Height="28"
                              Margin="0,0,10,0"
                              VerticalContentAlignment="Center"/>
                    <TextBlock Text="{Binding LastUpdateTimeText}"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button Content="{Binding RefreshButtonText}"
                            Style="{StaticResource CompactButton}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.45*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="0.55*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalUsedPercentText}"
                                       FontSize="40"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc TotalUsedLabel}"
                                       FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,10"/>
                            <ProgressBar Value="{Binding TotalProgressValue, Mode=OneWay}"
                                         Maximum="100"
                                         Height="8"
                                         FlowDirection="LeftToRight"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="#E5E7EB"
                                         BorderThickness="0"/>
                            <TextBlock Text="{Binding TotalProgressLabel}"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,10"/>
                            <TextBlock Text="{Binding TotalRemainingText}"
                                       FontSize="13"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding DaysUntilResetText}"
                                       FontSize="13"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource AccentLightBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc DailyTargetLabel}"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TotalDailyTargetText}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,2,0,8"/>
                            <TextBlock Text="{Binding TodaySpentText}"
                                       FontSize="12"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding TodayStatusText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TodayOverageText}"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TodayOverageText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc CursorModelsLabel}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding FirstPartyUsedPercentText}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="#6366F1"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{loc:Loc UsedLabel}"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>
                            <ProgressBar Value="{Binding FirstPartyProgressValue, Mode=OneWay}"
                                         Maximum="100"
                                         Height="8"
                                         FlowDirection="LeftToRight"
                                         Foreground="#6366F1"
                                         Background="#E5E7EB"
                                         BorderThickness="0"
                                         Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding FirstPartyPaceText}"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc ApiLabel}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ApiUsedPercentText}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="#0EA5E9"
                                       Margin="0,0,0,6"/>
                            <ProgressBar Value="{Binding ApiProgressValue, Mode=OneWay}"
                                         Maximum="100"
                                         Height="8"
                                         FlowDirection="LeftToRight"
                                         Foreground="#0EA5E9"
                                         Background="#E5E7EB"
                                         BorderThickness="0"
                                         Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ApiSpendText}"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ApiSpendText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ApiPaceText}"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding LastUpdateText}"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding PaceStatusText}"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding TodayPoolsDetailText}"
                                   FontSize="10"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,10,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap"
                           FontSize="12"/>
            </Border>

            <CheckBox Grid.Row="3"
                      Content="{loc:Loc LaunchWithWindows}"
                      IsChecked="{Binding IsStartupEnabled}"
                      FontSize="12"
                      Foreground="{StaticResource PrimaryTextBrush}"/>
        </Grid>
    </ScrollViewer>
</Window>


